{
  "name": "nobel-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Explore the history, ideas and connections behind every Nobel Prize.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "data:refresh": "node scripts/refresh-data.mjs",
    "data:draft-details": "node scripts/draft-details.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0"
  }
}
